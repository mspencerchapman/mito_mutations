# macOS
.DS_Store
.AppData*

# R session state
.Rhistory
.RData
.Rproj.user/
.Ruserdata
*.Rproj

# Knitr / rmarkdown intermediates
*_cache/
*_files/
*.knit.md
*.utf8.md

# ABC intermediates - large, regenerable from the simulation scripts.
# The posterior tables under */output/ ARE tracked: they are the analysis
# products the figures are built from.
data/Drift_ABC_clonal_expansions/*/sim.file.*
data/Drift_ABC_clonal_expansions/*/params_and_sumstats.*
data/Drift_ABC_clonal_expansions/*/abc.file.*

# Large processed data objects - hosted on Zenodo, fetched by download_data.R.
# The list of record is data/zenodo_manifest.csv (which IS tracked).
data/mito_data.Rds
data/mito_data_foetal.Rds
data/whole_genome_coverage_pileup_and_bedtools_annotated.csv
data/nonblood/mito_mutation_data_*.RDS
data/colony_drift_simulations/model*_res.Rds

# Staging directory for a Zenodo upload
zenodo_upload/

# Cached intermediate for Extended Data Fig. 2f - the per-mutation regressions of
# VAF against 1/copy number. Regenerated by Generate_ExtData_Fig2.R if absent
# (a few minutes); the published list of correlating mutations is the tracked
# data/CN_correlation.RDS, which this does not replace.
data/CN_correlation_pval_df.Rds

# Per-notebook plot output. Written only when save_plots is TRUE in config.R, and
# regenerable by re-knitting, so it is not tracked. The manuscript panels under
# plots/Figure_NN/ and plots/Extended_Data_Figure_NN/ ARE tracked.
plots/notebook_output/

# Default device file R creates when a base plot is drawn with no device open.
Rplots.pdf
